  "flaws": [
    {
      "Flaw ID": "F01",
      "Flaw Title": "Skooma / Moon Sugar Addiction",
      "Description": "Suffers crippling withdrawals and will prioritize securing a fix over basic necessities or group safety."
    },
    {
      "Flaw ID": "F02",
      "Flaw Title": "N'wah Xenophobia",
      "Description": "Deeply prejudiced against non-Dunmer (or outlanders of any race), refusing to trade fairly or speak respectfully to foreigners."
    },
    {
      "Flaw ID": "F03",
      "Flaw Title": "Ash-Lung Paranoia",
      "Description": "Terrified of the Blight and Corprus; refuses to travel in ash storms and excessively consumes cure disease potions."
    },
    {
      "Flaw ID": "F04",
      "Flaw Title": "Telvanni Arrogance",
      "Description": "Believes those without magical aptitude are lesser beings meant to serve, leading to dangerous overconfidence."
    },
    {
      "Flaw ID": "F05",
      "Flaw Title": "Camonna Tong Debt",
      "Description": "Owes a massive sum to the local xenophobic crime syndicate and is constantly looking over their shoulder."
    },
    {
      "Flaw ID": "F06",
      "Flaw Title": "Daedric Superstition",
      "Description": "Paralyzed by fear of Daedra; refuses to enter ruins, touch cursed gold, or use weapons with Daedric origins."
    },
    {
      "Flaw ID": "F07",
      "Flaw Title": "Sujamma Brawler",
      "Description": "Prone to heavy drinking that inevitably leads to aggressive, unprovoked honor duels in cornerclubs."
    },
    {
      "Flaw ID": "F08",
      "Flaw Title": "Kleptomania for the Mechanical",
      "Description": "Cannot resist the urge to steal Dwemer cogs, scrap metal, and artifacts, regardless of who is watching or the weight."
    },
    {
      "Flaw ID": "F09",
      "Flaw Title": "Blind Zealotry",
      "Description": "Unquestioningly obeys the Tribunal Temple; will assault 'heretics' and refuse aid from Imperial Cult healers."
    },
    {
      "Flaw ID": "F10",
      "Flaw Title": "Ashlander Traditionalist",
      "Description": "Refuses the comforts of civilization\u2014will not sleep in beds, eat tavern food, or trust established guilds."
    },
    {
      "Flaw ID": "F11",
      "Flaw Title": "Sleeper's Susceptibility",
      "Description": "Plagued by disturbing dreams of the Sixth House; struggles with insomnia and a growing urge to collect ash statues."
    },
    {
      "Flaw ID": "F12",
      "Flaw Title": "Hlaalu Greed",
      "Description": "Will betray allies, break contracts, and sell out morals if the offered sum of drakes is high enough."
    },
    {
      "Flaw ID": "F13",
      "Flaw Title": "Teleportation Sickness",
      "Description": "Refuses to use Guild Guides, Almsivi Intervention, or Divine Intervention due to a severe physical or mental aversion."
    },
    {
      "Flaw ID": "F14",
      "Flaw Title": "Pathological Lineage Liar",
      "Description": "Constantly invents grand tales about their ancestry to gain favor with the Great Houses."
    },
    {
      "Flaw ID": "F15",
      "Flaw Title": "Overly Trusting Outlander",
      "Description": "Painfully naive to the cutthroat politics of Vvardenfell, easily manipulated by merchants and nobles alike."
    },
    {
      "Flaw ID": "F16",
      "Flaw Title": "Morag Tong Target",
      "Description": "Has a legal writ of execution on their head and constantly suspects everyone around them is an assassin."
    },
    {
      "Flaw ID": "F17",
      "Flaw Title": "Necromantic Fascination",
      "Description": "Has a morbid obsession with corpses, tombs, and bonewalkers that deeply disturbs travel companions."
    },
    {
      "Flaw ID": "F18",
      "Flaw Title": "Fear of the Cliff Racer",
      "Description": "Refuses to travel the wilderness without a hired guard, terrified of the skies and ambush predators."
    },
    {
      "Flaw ID": "F19",
      "Flaw Title": "Vow of Poverty",
      "Description": "Refuses to accumulate wealth or wear extravagant armor, insisting on a life of austere spiritual discipline."
    },
    {
      "Flaw ID": "F20",
      "Flaw Title": "Imperial Sycophant",
      "Description": "Believes native Dunmer culture is entirely barbaric and aggressively forces Imperial law and customs on locals."
    }
  ],
  "ideals": [
    {
      "ID": "I01",
      "Name": "The False Gods",
      "Description": "The Tribunal are usurpers who stole their divinity; only the Anticipations (Azura, Boethiah, Mephala) are worthy of worship."
    },
    {
      "ID": "I02",
      "Name": "The Twin Lamps' Righteousness",
      "Description": "Slavery is an abomination, and the systematic dismantling of Vvardenfell's slave trade is a moral imperative."
    },
    {
      "ID": "I03",
      "Name": "The Necessity of Chains",
      "Description": "Slavery is a vital economic pillar of Morrowind and an ancient Dunmer right that outlanders have no business judging."
    },
    {
      "ID": "I04",
      "Name": "Hubris of the Dwarves",
      "Description": "The Dwemer brought their disappearance upon themselves; their technology is profane and should be left buried."
    },
    {
      "ID": "I05",
      "Name": "Martial Supremacy",
      "Description": "Magic is a coward's tool for those afraid to draw blood; true strength is measured in physical combat."
    },
    {
      "ID": "I06",
      "Name": "The Guild Bureaucracy",
      "Description": "The Mages and Fighters Guilds are corrupt, bureaucratic jokes; true mastery is found only in the Great Houses."
    },
    {
      "ID": "I07",
      "Name": "The Misunderstood Ur",
